# ============================================================
# TEMPLATE Streamlit Secrets - copy to: Settings -> Secrets
# (github.com/neornotl/rightly -> ... app -> Settings -> Secrets)
#
# AN TOÀN: file này nằm trong git công khai, KHÔNG điền key thật
# vào đây. Lấy block đã điền sẵn trong phần chat/email, hoặc mở
# .streamlit/secrets.toml (trên máy local, đã gitignore) để copy.
#
# Sau khi dán xong bấm "Save" -> app tự reload.
# ============================================================

# --- Chế độ vận hành ----------------------------------------
APP_MODE = "cloud"
ASR_BACKEND = "mock"          # phowhisper (torch) KHÔNG chạy được trên cloud
RETRIEVAL_BACKEND = "bm25"    # hybrid cần sentence-transformers (không có trên free tier)
TTS_BACKEND = "edge"          # BẮT BUỘC: nếu thiếu app sẽ CÂM (mặc định mock)
LLM_BACKEND = "mock"          # groq | gemini | mock (mock = trả lời mẫu có sẵn)
LLM_FALLBACK_BACKEND = ""     # ĐỂ TRỐNG: "gemini" mà thiếu GEMINI_API_KEY = app crash ngay lúc boot
RETRIEVER_GATE = "bm25_dense"

# --- LLM thật (muốn câu trả lời thông minh) -----------------
# LLM_BACKEND = "groq"
# GROQ_API_KEY = "gsk_..."      # bắt buộc nếu LLM_BACKEND=groq
# GROQ_API_KEY_2 = "gsk_..."
# GROQ_API_KEY_3 = "gsk_..."
# (nhiều key = tự động xoay khi 429/5xx)
# GEMINI_API_KEY = "AIza..."    # chỉ cần nếu LLM_BACKEND=gemini

# --- TTS: FPT.AI (giọng banmai tự nhiên nhất) ---------------
# Lấy key free tại fpt.ai (500 ký tự/request, 20k req/tháng).
# LƯU Ý: free tier rate-limit gắt (~1-2 req/phút); khi 429
# chain tự rơi xuống Zalo -> Edge-TTS -> gTTS -> Mock (không bao giờ câm).
FPT_AI_API_KEY = ""
ZALO_AI_API_KEY = ""
EDGE_TTS_VOICE = "vi-VN-HoaiMyNeural"
EDGE_TTS_RATE = "-15%"        # council R19: chậm 15% + pitch +5Hz cho người già
# EDGE_TTS_PITCH = "+5Hz"      # (nếu backend hỗ trợ)

# --- Quyền riêng tư ------------------------------------------
PII_SCRUB_OUTBOUND = "true"   # scrub số điện thoại/CMND trước khi gửi LLM cloud
SAVE_TRANSCRIPTS = "false"
DELETE_RAW_AUDIO_AFTER_SESSION = "true"
LOG_RETENTION_DAYS = "30"

# --- Chống lạm dụng (demo-grade) -----------------------------
RATE_LIMIT_PER_IP = "60"
RATE_LIMIT_WINDOW_SECONDS = "3600"

# --- Tuỳ chọn khác -------------------------------------------
MAX_RESPONSE_CHARS = "2000"   # giới hạn độ dài câu trả lời (ky tu)
# DATA_DIR = "data"
# RESULTS_DIR = "results"
# LOG_DIR = "logs"
# OFFICIAL_HOTLINE_LABEL = "Đường dây nóng (chưa xác minh)"
# OFFICIAL_HOTLINE_VALUE = "1900XXXX"
# OFFICIAL_ONE_STOP_LABEL = "Bộ phận một cửa (chưa xác minh)"
# OFFICIAL_ONE_STOP_VALUE = "Chưa có"