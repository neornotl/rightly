# Tieng Lang - environment template.
# Copy to .env and fill values. NEVER commit the real .env file.

# Mode: mock | local | cloud
APP_MODE=mock

# Backends
ASR_BACKEND=mock            # mock | phowhisper
RETRIEVAL_BACKEND=bm25      # bm25
LLM_BACKEND=mock            # mock | gemini | groq
TTS_BACKEND=mock            # mock | edge

# Paths (defaults are relative to project root)
DATA_DIR=data
RESULTS_DIR=results
LOG_DIR=logs

# LLM API keys (leave empty unless using cloud backends)
GEMINI_API_KEY=
GROQ_API_KEY=

# Privacy
DELETE_RAW_AUDIO_AFTER_SESSION=true
SAVE_TRANSCRIPTS=false
LOG_DIRECTORY=data

# Limits
MAX_CONTEXT_CHARS=12000
MAX_RESPONSE_CHARS=2000
MIN_RETRIEVAL_SCORE=1.0

# Edge-TTS
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_RATE=+0%

# Official channels (PLACEHOLDERS - must be verified by the human team
# before deployment; do not use unverified numbers)
OFFICIAL_HOTLINE_LABEL=Đường dây nóng (chưa xác minh)
OFFICIAL_HOTLINE_VALUE=1900XXXX
OFFICIAL_ONE_STOP_LABEL=Bộ phận một cửa (chưa xác minh)
OFFICIAL_ONE_STOP_VALUE=Chưa có
