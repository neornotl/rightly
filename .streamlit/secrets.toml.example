# TEMPLATE - copy into the Streamlit Cloud dashboard (Settings -> Secrets).
# NEVER put the real key in this file. The example file is safe to commit.
# The app merges these secrets into environment variables at startup.
# REQUIRED for demo/public (F3+F4): paste 3 Groq keys + 1 Gemini key.

APP_MODE = "cloud"
LLM_BACKEND = "groq"
LLM_FALLBACK_BACKEND = "gemini"
ASR_BACKEND = "mock"
RETRIEVAL_BACKEND = "bm25"
TTS_BACKEND = "edge"

# Key rotation (F4): fill GROQ_API_KEY first, then _2/_3. On 429/5xx the app
# rotates automatically. At least one key must be valid.
GROQ_API_KEY = "gsk_..."
# GROQ_API_KEY_2 = "gsk_..."
# GROQ_API_KEY_3 = "gsk_..."

# Gemini fallback (F4): used when every Groq key fails.
GEMINI_API_KEY = "AIza..."

# TTS (council R19: FPT.AI primary - most natural voice + roomiest free tier).
# Zalo AI demoted (free tier ~1-2 req/min). Without keys the chain uses
# Edge-TTS (rate -15%, pitch +5Hz) then gTTS.
FPT_AI_API_KEY = ""
ZALO_AI_API_KEY = ""

# Abuse guard (F4): per-client hourly cap (per instance, demo-grade).
RATE_LIMIT_PER_IP = "60"
RATE_LIMIT_WINDOW_SECONDS = "3600"

PII_SCRUB_OUTBOUND = "true"
LOG_RETENTION_DAYS = "30"
SAVE_TRANSCRIPTS = "false"
DELETE_RAW_AUDIO_AFTER_SESSION = "true"

# Voice FAQ (F5): loaded automatically from data/faq.json when present.
# Optional max chars for answers:
MAX_RESPONSE_CHARS = "2000"
